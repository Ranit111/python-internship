      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login Form",
        "description": "OAuth2 compatible token login, get an access token for future requests.\nAccepts standard application/x-www-form-urlencoded (username=email, password=pass).",
        "operationId": "login_form_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_form_api_v1_auth_login_post"
